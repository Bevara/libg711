{
    "name": "libg711",
    "description": "G.711 A-law and mu-law decoder",
    "filters":["g711dec","rfg711"],
    "help": "This filter decodes ITU-T G.711 audio, both A-law and mu-law, to raw 16-bit PCM.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/libg711.accessor",
    "filter_source":{
        "g711dec" : "dec_g711.c",
        "rfg711" : "reframe_g711.c"
    },
    "extension":{
      "wav" : "audio"
    },
    "licence_required":false
}
